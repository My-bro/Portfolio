# En-têtes appliqués par Cloudflare Workers Assets.

# Médias transcodés : leur nom est stable, donc une image refaite garde son
# URL. Une semaine de cache laissait alors l'ancienne version à qui l'avait
# déjà vue — ce qui s'est vu au passage en gris, les vignettes des démos
# restant orange côté visiteur. Une heure suffit à épargner les
# rechargements d'une même visite, et `stale-while-revalidate` sert
# l'ancienne pendant qu'il va chercher la nouvelle, donc sans attente.
/m/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Bundles Next : le nom contient déjà un hash de contenu.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
