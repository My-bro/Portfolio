{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "wasm:build": "vendor/raytracer/wasm/build.sh \"$PWD/public/wasm\"",
    "rtype:build": "vendor/r-type/wasm/pack-assets.sh && vendor/r-type/wasm/build.sh \"$PWD/public/rtype\" && rm -rf public/rtype/video && cp -R vendor/r-type/wasm/web/video public/rtype/",
    "myhunter:build": "vendor/my-hunter/wasm/pack-assets.sh && vendor/my-hunter/wasm/build.sh \"$PWD/public/myhunter\"",
    "myrpg:build": "vendor/my-rpg/wasm/pack-assets.sh && vendor/my-rpg/wasm/build.sh \"$PWD/public/myrpg\"",
    "area:build": "scripts/area-build.sh",
    "minishell:build": "vendor/minishell/wasm/build.sh \"$PWD/public/minishell\"",
    "dante:build": "vendor/dante/solver/wasm/build.sh \"$PWD/public/dante\"",
    "bsq:build": "vendor/bsq/wasm/build.sh \"$PWD/public/bsq\"",
    "sokoban:build": "vendor/sokoban/wasm/build.sh \"$PWD/public/sokoban\"",
    "pushswap:build": "vendor/push-swap/wasm/build.sh \"$PWD/public/pushswap\"",
    "navy:build": "vendor/my-navy/wasm/build.sh \"$PWD/public/navy\" && cp vendor/my-navy/pos*.txt public/navy/",
    "radar:build": "vendor/my-radar/wasm/pack-assets.sh && vendor/my-radar/wasm/build.sh \"$PWD/public/radar\"",
    "media:sync": "node scripts/media-sync.mjs",
    "media:sync:force": "node scripts/media-sync.mjs --force",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run media:sync && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:check": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply portfolio-metrics --remote",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-metrics --local",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
